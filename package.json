{
  "name": "rickdev-presence",
  "version": "1.2.0",
  "description": "Editor personalizável de Discord Rich Presence",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test",
    "build": "electron-builder --win portable"
  },
  "build": {
    "appId": "dev.rick.discordpresence",
    "productName": "RickDev Presence Studio",
    "artifactName": "RickDev Presence Studio.${ext}",
    "files": [
      "src/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": "portable"
    }
  },
  "dependencies": {
    "discord-rpc": "^4.0.1"
  },
  "devDependencies": {
    "electron": "^36.0.0",
    "electron-builder": "^26.0.12"
  }
}
